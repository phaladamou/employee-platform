NEXT_PUBLIC_TWITTER_CLIENT_ID=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ---------------------------------------------------------------------------
# EmployeeCore (API + worker). Only file read by core/employee/cli.ts is
# .env.local — copy the block below there and fill the secrets.
# ---------------------------------------------------------------------------
# State: all core state lives under these dirs (volumes in Docker/cloud).
EMPLOYEE_DATA=.data/employee
EMPLOYEE_SANDBOX=.data/workspace
EMPLOYEE_WORKSPACES_DIR=.data/workspaces
EMPLOYEE_PROFILES=core/employee/profiles

# API endpoint the CLI talks to (serve prints the real URL on boot).
EMPLOYEE_API_URL=http://127.0.0.1:8000
# Bearer token for hire/submit/status/... (an emo_... key from `keys issue`).
EMPLOYEE_TOKEN=

# Port for `serve` (Cloud Run convention). Precedence: --port > PORT > 8000.
PORT=8000

# LLM provider: deepseek (code default) | muse. Only the chosen key is required.
EMPLOYEE_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3

# Strict shell backend (Rust): rlimits + Landlock confinement of every
# shell to its employee workspace (ADR-015). Unset = Node exec fallback
# (same messages, but cwd-only confinement — no filesystem isolation).
# Build with: cargo build --locked --release --bin emp-sandbox
# Required in production when shells run untrusted commands.
EMPLOYEE_SANDBOX_BIN=