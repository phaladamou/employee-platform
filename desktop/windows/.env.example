DEEPSEEK_API_KEY=
OPENAI_BASE_URL=
AUTH_SECRET=
POSTGRES_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
TAVILY_API_KEY=
NEXT_PUBLIC_BASE_URL=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
