{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.js",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "desktop",
    "lib/auth/route-policy.test.ts",
    "lib/auth/sticky-session.test.ts",
    "lib/chat-draft.test.ts",
    "lib/chef/actions.test.ts",
    "lib/cli/commands.test.ts",
    "lib/cli/confirm.test.ts",
    "lib/cli/parser.test.ts",
    "lib/chef/onboarding.test.ts",
    "lib/employees/catalog.test.ts",
    "lib/employees/department-url.test.ts",
    "lib/connectors/load-safety.test.ts",
    "lib/employees/departments.test.ts",
    "lib/server/web-mission-mapping.test.ts",
    "lib/server/sse-parse.test.ts",
    "lib/server/employee-conversation-mapping.test.ts",
    "lib/billing/billing.test.ts",
    "lib/employees/talents.test.ts",
    "lib/employees/rich-profiles.test.ts",
    "lib/employees/mission-events.test.ts",
    "lib/employees/session-history.test.ts",
    "lib/engineering/cli-commands.test.ts",
    "lib/engineering/files.test.ts",
    "lib/engineering/workspace-sync.test.ts",
    "lib/i18n/locale.test.ts",
    "lib/otp-email-template.test.ts",
    "lib/sidebar/nav-state.test.ts",
    "lib/db/chat-scope.test.ts",
    "core/employee/**/*.test.ts",
    "core/models/chat-provider.test.ts",
    "vitest.config.ts"
  ]
}